[sub_resource type="GDScript" id="GDScript_x3ltn"]
resource_name = "exit"
script/source = "extends Area2D

var check = 0

signal entered_exit(path)


func _ready():
	add_to_group(\"exit\")

func _on_body_entered(body):
	if check == 1:
		return
	if body.name == \"Player\":
		check = 1
		emit_signal(\"entered_exit\", \"res://scenes/levels/1.tscn\")
"

